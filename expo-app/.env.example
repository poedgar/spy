# Local development: your machine's LAN IP or a tunnel URL serving laravel-app
EXPO_PUBLIC_API_URL=http://192.168.1.10:8000
EXPO_PUBLIC_PUSHER_KEY=
EXPO_PUBLIC_PUSHER_CLUSTER=mt1
# "Continue with Google" via Firebase (Firebase console → Project settings).
EXPO_PUBLIC_FIREBASE_API_KEY=
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=
EXPO_PUBLIC_FIREBASE_PROJECT_ID=
EXPO_PUBLIC_FIREBASE_APP_ID=
# The "Web client" OAuth client id (Google Cloud → Credentials, auto-created by Firebase)
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=
