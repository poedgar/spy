```gitignore
# Dependencies
node_modules/

# Build outputs
dist/
build/
*.js.map
*.ts.map

# Environment variables
.env
.env.local
*.env.*

# IDE and editor files
.vscode/
.idea/
*.swp
*.swo
*.tmp

# Logs
*.log

# Python (if present)
__pycache__/
*.pyc
*.pyo
*.pyd

# Coverage reports
coverage/
htmlcov/
.coverage

# Distribution / packaging
*.tar.gz
*.whl
*.egg-info/

# OS generated files
.DS_Store
Thumbs.db

# Testing
.nyc_output/
coverage.xml
*.gcda
*.gcno
```