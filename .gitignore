```gitignore
# Dependencies
node_modules/

# Build outputs
dist/
build/
*.js.map
*.ts.map

# Environment variables
.env
.env.local
*.env.*

# Logs
*.log

# Coverage reports
coverage/
.nyc_output/
*.lcov

# IDE files
.vscode/
.idea/
*.swp
*.swo

# OS files
.DS_Store
Thumbs.db

# Python specific (if applicable)
__pycache__/
*.pyc
*.pyo
*.pyd
.Python
*.so
.coverage
htmlcov/
.pytest_cache/
.mypy_cache/

# Node.js specific (if applicable)
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Compiled assets
*.min.js
*.min.css
bundle.js
bundle.css

# Temporary files
*.tmp
*.temp
.DS_Store
```